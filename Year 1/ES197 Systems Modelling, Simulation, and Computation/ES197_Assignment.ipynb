   "source": [
    "def binomialCoeffs(n):\n",
    "    coeffs = np.zeros(n+1)\n",
    "    r = np.arange(start=0, stop=n+1)\n",
    "    nShriek = np.prod(np.arange(start=1, stop=n+1))\n",
    "    for k in r:\n",
    "        kShriek = np.prod(np.arange(start=1, stop=k+1))\n",
    "        nmrShriek = np.prod(np.arange(start=1, stop=n-k+1))\n",
    "        coeffs[k] = (nShriek/(kShriek*(nmrShriek)))\n",
    "    return coeffs.astype(dtype=int)\n",
    "\n",
    "def get_fc_range(dBGain, n, freq):\n",
    "    nRange = np.arange(1, n+1)\n",
    "    linGain = 10**(dBGain/20)\n",
    "    fcRange = freq/np.sqrt(linGain**(-2/nRange)-1)\n",
    "    return fcRange\n",
    "\n",
    "noiseBin = np.where(freq >= noisyFreq)[0][0]\n",
    "signalBin = np.where(freq < noisyFreq)[0][-1]\n",
    "noiseRMS = np.sum(Y[noiseBin:]**2)\n",
    "signalRMS = np.sum(Y[:signalBin]**2)\n",
    "SNR = 10*np.log10(signalRMS/noiseRMS)\n",
    "targetSNR = 70\n",
    "n = 10\n",
    "nRange = np.arange(1, n+1)\n",
    "Afilt = -(targetSNR-SNR)\n",
    "cornerFreqRange = get_fc_range(Afilt, n, noisyFreq)\n",
    "neg3dBFreqRange = cornerFreqRange*np.sqrt(2**(1/np.arange(1, 11))-1)\n",
    "\n",
    "fig = plt.figure(figsize=(7, 6))\n",
    "plt.bar(nRange-0.2, neg3dBFreqRange, 0.4); plt.bar(nRange+0.2, cornerFreqRange, 0.4)\n",
    "plt.title(\"Comparison of Cutoff Frequency and Frequency at -3dB\")\n",
    "plt.legend([\"$f_{-3dB}$\", \"$f_{c}$\"])\n",
    "plt.xlabel(\"Order (n)\"); plt.ylabel(\"Frequency (Hz)\")\n",
    "plt.xticks(nRange,labels=[f\"{x}\" for x in nRange])\n",
    "caption = r\"$\\it{Figure~2}$: These frequencies correspond to having the desired attenuation at $f_{n1}$.\"\n",
    "plt.figtext(0.5, 0.001, caption, wrap=True, horizontalalignment='center', fontsize=10);\n",
    "\n",
    "cascadedOrder = 5\n",
    "cascadedFc = cornerFreqRange[cascadedOrder-1]\n",
    "R = 1E03\n",
    "C = 1/(2*np.pi*R*cascadedFc)\n",
    "RC = R*C\n",
    "# used formula of C = 1/(2pi*R*fc) where we use 1k ohms as a standard value\n",
    "coeffs = binomialCoeffs(cascadedOrder)\n",
    "RCPowers = np.zeros(cascadedOrder+1)\n",
    "for i in range(len(RCPowers)):\n",
    "    RCPowers[i] = RC**i\n",
    "denom = coeffs * np.flip(RCPowers)\n",
    "\n",
    "bz, az = sc.signal.bilinear(1, denom, fs)\n",
    "lowpassFilteredAudio = sc.signal.lfilter(bz, az, song)\n",
    "lowpassFilteredAudio /= np.max(np.abs(lowpassFilteredAudio))\n",
    "Yfilt = (np.abs(sc.fft.rfft(lowpassFilteredAudio)))/L\n",
    "Yfilt[1:-1] *= 2\n",
    "newNoiseRMS = np.sum(Yfilt[noiseBin:]**2)\n",
    "newSignalRMS = np.sum(Yfilt[:signalBin]**2)\n",
    "newSNR = 10*np.log10(newSignalRMS/newNoiseRMS)\n",
    "\n",
    "fig = plt.figure(figsize=(7, 6))\n",
    "ax = fig.add_subplot()\n",
    "ax.plot(freq, Yfilt)\n",
    "ax.set_title(f'Single-Sided FFT (Cascaded Design, n = {cascadedOrder:g})')\n",
    "ax.set_xlabel('Frequency (Hz)')\n",
    "ax.set_ylabel('Amplitude')\n",
    "caption = r\"$\\it{Figure~3}$: A single-sided FFT of the filtered audio data.\"\n",
    "plt.figtext(0.5, 0.001, caption, wrap=True, horizontalalignment='center', fontsize=10);\n",
    "ax.text(10000, 0.02, f\"Old SNR: {SNR:.1f}dB, new SNR: {newSNR:.1f}dB\", bbox=dict(boxstyle=\"square\", facecolor=\"none\", edgecolor=\"black\"));"
   ]
  },
